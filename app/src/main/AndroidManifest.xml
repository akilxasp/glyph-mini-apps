<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <!-- Lets the app re-arm the glyph debug flag itself (granted once via adb pm grant). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- See all launchable apps for the Notify Glyph picker. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name">

        <!-- On-demand app-control loop, driven by the QS tile. -->
        <service
            android:name=".GolService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Quick Settings tile: the on-demand trigger. -->
        <service
            android:name=".GolTileService"
            android:exported="true"
            android:icon="@drawable/ic_snake"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Garden: ambient flower loop, driven by its own QS tile. -->
        <service
            android:name=".GardenService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Garden QS tile. Long-press opens the flower picker. -->
        <service
            android:name=".GardenTileService"
            android:exported="true"
            android:icon="@drawable/ic_flower"
            android:label="@string/garden_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Line shooter: self-playing arcade loop, driven by its own QS tile. -->
        <service
            android:name=".ShooterService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <service
            android:name=".ShooterTileService"
            android:exported="true"
            android:icon="@drawable/ic_shooter"
            android:label="@string/shooter_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Reaction timer: Essential Key press-to-flash-to-measure, driven by its own QS tile. -->
        <service
            android:name=".ReactionService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <service
            android:name=".ReactionTileService"
            android:exported="true"
            android:icon="@drawable/ic_reaction"
            android:label="@string/reaction_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Essential Key → Shooter missile. Key filtering only. -->
        <service
            android:name=".EssentialKeyService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/essential_key_service" />
        </service>

        <!-- Invisible router: every tile's long-press lands here, dispatched by source tile. -->
        <activity
            android:name=".SettingsRouterActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FlowerPickerActivity"
            android:exported="false"
            android:label="@string/garden_tile_label"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Notif-to-Glyph: shows any app's icon on the matrix (needs Notification access grant). -->
        <service
            android:name=".NotifGlyphListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".NotifDisplayService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Now Playing marquee: owns the matrix while listening to media sessions. -->
        <service
            android:name=".GlyphMediaService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <service
            android:name=".MediaTileService"
            android:exported="true"
            android:icon="@drawable/ic_music"
            android:label="@string/media_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Master on/off tile; long-press opens the app picker. -->
        <service
            android:name=".NotifTileService"
            android:exported="true"
            android:icon="@drawable/ic_bell"
            android:label="@string/notif_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".NotifSettingsActivity"
            android:exported="true"
            android:label="@string/notif_tile_label"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Ambient Always-on Glyph Toy: user selects it in Glyph Interface settings. -->
        <service
            android:name=".GolToyService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data android:name="com.nothing.glyph.toy.name" android:resource="@string/toy_name" />
            <meta-data android:name="com.nothing.glyph.toy.image" android:resource="@drawable/toy_preview" />
            <meta-data android:name="com.nothing.glyph.toy.aod_support" android:value="1" />
        </service>

    </application>
</manifest>
